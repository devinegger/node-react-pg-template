PORT=4000 # Express server port
NODE_ENV=development # Environment: development | production | test

POSTGRES_HOST=localhost # For Docker: use 'app-db' inside Docker network, 'localhost' from host
POSTGRES_PORT=5432 # Default Postgres port
POSTGRES_DB=app_db # Database name
POSTGRES_USER=app_user # Database user
POSTGRES_PASSWORD=password # Database password (change in real projects)

ENCRYPTION_KEY=change-me-32-bytes-minimum # Used for any encryption utilities

ANTHROPIC_API_KEY=sk-ant-xxx # Optional: API key for integrations; safe to leave unset in local dev

